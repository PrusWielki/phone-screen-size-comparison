---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Screen Size Overlay Tool">
  <div class="min-h-screen flex flex-col bg-slate-950 text-slate-100 font-sans">
    
    <!-- Simple Header -->
    <header class="p-4 border-b border-slate-900 flex justify-between items-center max-w-6xl w-full mx-auto">
      <h1 class="text-xl font-bold tracking-tight text-white">Screen Size Overlay</h1>
      <a href="https://github.com/PrusWielki/phone-screen-size-comparison" target="_blank" rel="noopener noreferrer" class="text-xs text-slate-400 hover:text-white">
        GitHub
      </a>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-6xl w-full mx-auto p-4 grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Controls Column -->
      <section class="md:col-span-1 flex flex-col gap-4">
        <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl shadow-lg">
          <div class="flex justify-between items-center mb-3">
            <h2 class="font-bold text-white">Screens</h2>
            <button id="add-btn" class="btn btn-primary btn-xs rounded">Add Screen</button>
          </div>

          <!-- Alignment Options -->
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-800">
            <span class="text-xs text-slate-400 font-semibold">Alignment</span>
            <div class="join border border-slate-800 p-0.5 rounded bg-slate-950">
              <button id="btn-align-center" class="btn btn-xs rounded join-item btn-ghost text-white btn-active">Center</button>
              <button id="btn-align-bottom-left" class="btn btn-xs rounded join-item btn-ghost text-slate-400">Bottom-Left</button>
            </div>
          </div>
          
          <!-- Screen inputs list -->
          <div id="screen-inputs" class="space-y-4">
            <!-- Rendered dynamically -->
          </div>
        </div>
      </section>

      <!-- Visualization Column -->
      <section class="md:col-span-2 flex flex-col gap-4">
        <!-- Visual Canvas -->
        <div class="relative w-full h-[400px] md:h-[500px] bg-slate-950 border border-slate-800 rounded-xl overflow-hidden shadow-inner flex items-center justify-center">
          <!-- Dot grid background -->
          <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:20px_20px] pointer-events-none"></div>
          
          <!-- Screens wrapper -->
          <div id="canvas-overlay" class="relative w-full h-full flex items-center justify-center">
            <!-- Overlaid rectangles go here -->
          </div>
        </div>
      </section>

    </main>

    <!-- Simple Footer -->
    <footer class="p-4 border-t border-slate-900 text-center text-xs text-slate-500">
      <p>Compare screen dimensions by diagonal inches and aspect ratios. Overlaid relative size.</p>
    </footer>
  </div>
</Layout>

<script>
  interface Screen {
    id: string;
    diagonal: number;
    aspectW: number;
    aspectH: number;
    color: string;
  }

  // Pre-configured starting screens
  let screens: Screen[] = [
    { id: "s1", diagonal: 6.7, aspectW: 19.5, aspectH: 9, color: "#3b82f6" },
    { id: "s2", diagonal: 5.5, aspectW: 16, aspectH: 9, color: "#ef4444" }
  ];

  let alignMode: 'center' | 'bottom-left' = 'center';

  const colors = ["#3b82f6", "#ef4444", "#10b981", "#f59e0b", "#8b5cf6", "#ec4899"];

  const container = document.getElementById('screen-inputs')!;
  const addBtn = document.getElementById('add-btn')!;
  const canvas = document.getElementById('canvas-overlay')!;
  const btnAlignCenter = document.getElementById('btn-align-center')!;
  const btnAlignBottomLeft = document.getElementById('btn-align-bottom-left')!;

  function init() {
    // Load from local storage
    const stored = localStorage.getItem('overlay_screens');
    if (stored) {
      screens = JSON.parse(stored);
    }

    const storedAlign = localStorage.getItem('overlay_align');
    if (storedAlign === 'center' || storedAlign === 'bottom-left') {
      alignMode = storedAlign;
    }
    
    addBtn.addEventListener('click', addScreen);

    btnAlignCenter.addEventListener('click', () => {
      alignMode = 'center';
      saveAlign();
      updateAlignButtons();
      renderVisuals();
    });

    btnAlignBottomLeft.addEventListener('click', () => {
      alignMode = 'bottom-left';
      saveAlign();
      updateAlignButtons();
      renderVisuals();
    });

    updateAlignButtons();
    render();
  }

  function save() {
    localStorage.setItem('overlay_screens', JSON.stringify(screens));
  }

  function saveAlign() {
    localStorage.setItem('overlay_align', alignMode);
  }

  function updateAlignButtons() {
    if (alignMode === 'center') {
      btnAlignCenter.classList.add('btn-active', 'text-white');
      btnAlignCenter.classList.remove('text-slate-400');
      btnAlignBottomLeft.classList.remove('btn-active', 'text-white');
      btnAlignBottomLeft.classList.add('text-slate-400');
    } else {
      btnAlignBottomLeft.classList.add('btn-active', 'text-white');
      btnAlignBottomLeft.classList.remove('text-slate-400');
      btnAlignCenter.classList.remove('btn-active', 'text-white');
      btnAlignCenter.classList.add('text-slate-400');
    }
  }

  function addScreen() {
    const nextColor = colors[screens.length % colors.length];
    screens.push({
      id: `s-${Date.now()}`,
      diagonal: 6.0,
      aspectW: 16,
      aspectH: 9,
      color: nextColor
    });
    render();
  }

  function deleteScreen(id: string) {
    screens = screens.filter(s => s.id !== id);
    render();
  }

  function updateScreen(id: string, field: keyof Screen, value: any) {
    const screen = screens.find(s => s.id === id);
    if (screen) {
      (screen as any)[field] = value;
      save();
      renderVisuals();
    }
  }

  // Compute physical dimensions
  function getDims(s: Screen) {
    const d = s.diagonal;
    const wRatio = s.aspectW;
    const hRatio = s.aspectH;
    
    // Compute aspect ratio as decimal
    const r = wRatio / hRatio;
    
    // w^2 + h^2 = d^2  and  w = r * h
    // (r*h)^2 + h^2 = d^2 => h^2 * (r^2 + 1) = d^2
    const h = d / Math.sqrt(r * r + 1);
    const w = r * h;
    const area = w * h;

    return { w, h, area };
  }

  function render() {
    save();
    renderInputs();
    renderVisuals();
  }

  function renderInputs() {
    container.innerHTML = '';
    
    screens.forEach((s, idx) => {
      const card = document.createElement('div');
      card.className = "p-3 bg-slate-950 border border-slate-800 rounded-lg space-y-3 relative";
      
      card.innerHTML = `
        <div class="flex justify-between items-center">
          <span class="text-xs font-bold text-white">Screen #${idx + 1}</span>
          <button class="text-slate-500 hover:text-red-400 text-[10px] btn-del" data-id="${s.id}">Delete</button>
        </div>
        
        <div class="grid grid-cols-3 gap-2">
          <div>
            <label class="block text-[10px] text-slate-500 mb-0.5">Diagonal (in)</label>
            <input type="number" step="0.1" class="input input-bordered input-xs w-full text-center font-bold bg-slate-900 border-slate-800 inp-diag" data-id="${s.id}" value="${s.diagonal}">
          </div>
          <div>
            <label class="block text-[10px] text-slate-500 mb-0.5">Aspect W</label>
            <input type="number" step="0.1" class="input input-bordered input-xs w-full text-center bg-slate-900 border-slate-800 inp-w" data-id="${s.id}" value="${s.aspectW}">
          </div>
          <div>
            <label class="block text-[10px] text-slate-500 mb-0.5">Aspect H</label>
            <input type="number" step="0.1" class="input input-bordered input-xs w-full text-center bg-slate-900 border-slate-800 inp-h" data-id="${s.id}" value="${s.aspectH}">
          </div>
        </div>

        <div class="flex gap-2 items-center">
          <label class="text-[10px] text-slate-500">Color:</label>
          <input type="color" class="w-6 h-5 rounded cursor-pointer border border-slate-850 bg-transparent inp-color" data-id="${s.id}" value="${s.color}">
        </div>
      `;

      // Events
      card.querySelector('.btn-del')!.addEventListener('click', () => deleteScreen(s.id));
      
      card.querySelector('.inp-diag')!.addEventListener('input', (e) => {
        const val = parseFloat((e.target as HTMLInputElement).value);
        if (!isNaN(val) && val > 0) updateScreen(s.id, 'diagonal', val);
      });
      
      card.querySelector('.inp-w')!.addEventListener('input', (e) => {
        const val = parseFloat((e.target as HTMLInputElement).value);
        if (!isNaN(val) && val > 0) updateScreen(s.id, 'aspectW', val);
      });

      card.querySelector('.inp-h')!.addEventListener('input', (e) => {
        const val = parseFloat((e.target as HTMLInputElement).value);
        if (!isNaN(val) && val > 0) updateScreen(s.id, 'aspectH', val);
      });

      card.querySelector('.inp-color')!.addEventListener('input', (e) => {
        updateScreen(s.id, 'color', (e.target as HTMLInputElement).value);
      });

      container.appendChild(card);
    });
  }

  function renderVisuals() {
    canvas.innerHTML = '';
    
    if (screens.length === 0) return;

    const width = canvas.clientWidth;
    const height = canvas.clientHeight;
    
    const margin = 40;
    const renderW = width - margin;
    const renderH = height - margin;

    // Get physical dimensions
    const items = screens.map(s => ({
      id: s.id,
      color: s.color,
      diagonal: s.diagonal,
      aspectW: s.aspectW,
      aspectH: s.aspectH,
      dims: getDims(s)
    }));

    // Find scale: fit the largest width/height
    const maxW = Math.max(...items.map(item => item.dims.w));
    const maxH = Math.max(...items.map(item => item.dims.h));
    
    const scaleX = renderW / maxW;
    const scaleY = renderH / maxH;
    const scale = Math.min(scaleX, scaleY);

    items.forEach((item, idx) => {
      const wPx = item.dims.w * scale;
      const hPx = item.dims.h * scale;

      const el = document.createElement('div');
      el.className = "absolute border-2 transition-all duration-200 flex flex-col justify-between p-2 pointer-events-none";
      el.style.borderColor = item.color;
      el.style.background = `${item.color}0a`;
      el.style.width = `${wPx}px`;
      el.style.height = `${hPx}px`;
      
      // Position based on alignment mode
      if (alignMode === 'center') {
        el.style.left = `${(width - wPx) / 2}px`;
        el.style.top = `${(height - hPx) / 2}px`;
      } else {
        // Bottom-Left
        el.style.left = '20px';
        el.style.top = `${height - hPx - 20}px`;
      }

      el.innerHTML = `
        <div class="text-[9px] font-bold" style="color: ${item.color}">#${idx + 1} (${item.diagonal.toFixed(1)}")</div>
        <div class="text-[9px] text-slate-400 text-center pointer-events-none">
          ${item.dims.w.toFixed(1)}" x ${item.dims.h.toFixed(1)}"
          <div class="text-[8px] text-slate-500">${item.dims.area.toFixed(1)} sq in</div>
        </div>
        <div class="text-[8px] text-right text-slate-500">${item.aspectW}:${item.aspectH}</div>
      `;

      canvas.appendChild(el);
    });
  }

  // Handle window resizing
  let resizeTimer: any;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(renderVisuals, 100);
  });

  init();
</script>
